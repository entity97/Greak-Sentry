# Copy this file to ".env" and fill it in. Never upload .env to GitHub.

# Required: your bot token from Fluxer's bot settings
FLUXER_TOKEN=

# Recommended: your server's ID (right-click the server > Copy ID).
# If blank, the bot uses the first server it's in.
GUILD_ID=

# Optional: makes Twitch alerts faster and more reliable (see README)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: DEBUG shows much more detail in the logs
LOG_LEVEL=INFO
